<group name="attack.web">
  <rule id="10007" level="10" frequency="10" timeframe="60">
    <if_matched_sid>31101</if_matched_sid>
    <match>POST /login.php</match>
    <description>Web Attack: Brute force attempt detected against login page</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="10008" level="12">
    <if_sid>31101</if_sid>
    <url_match>UNION|SELECT|OR '1'='1|DROP|INSERT|UPDATE</url_match>
    <description>Web Attack: SQL Injection attempt detected in request</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="10009" level="13">
    <if_sid>31101</if_sid>
    <url_match>&&|%26%26|;|%3B|\|%7C</url_match>
    <description>Web Attack: Command injection attempt detected in request</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="10010" level="8">
    <if_sid>31101</if_sid>
    <match>GET /</match>
    <url_match>/admin|/.git|/.env|/config|/backup</url_match>
    <description>Web Attack: Directory enumeration attempt detected</description>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>
</group>
