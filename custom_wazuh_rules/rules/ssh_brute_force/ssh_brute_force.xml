<group name="ssh,authentication,brute_force">
  <rule id="10001" level="12" frequency="15" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>SSH Brute Force: 15 failed login attempts in 2 minutes from same IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>attack.brute_force</group>
  </rule>
</group>
